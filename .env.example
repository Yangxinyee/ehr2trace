# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Read-only root of the raw hospital export (contains PHI). Never written to.
EHR_DATA_ROOT=/path/to/read-only/ehr-export

# All outputs (source/, canonical/, omop/, meds/, runs/) go here. Contains PHI.
EHR_WORK_ROOT=/path/to/work/ehr2cdm

# duckdb (default, single file) or postgres
OMOP_BACKEND=duckdb

# Optional: local OMOP vocabulary (Athena download) as CSV directory or duckdb file.
# Without it every concept_id is 0 and every term goes to review.
OMOP_VOCAB_DIR=

# Local OpenAI-compatible endpoint. Used only by the two proposal steps; never for ETL.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=
LLM_API_KEY=not-needed

# 1 = refuse any network egress from the package (default).
OFFLINE_MODE=1

# Optional secret salt for the MRN -> subject_id mapping. Keep it out of the repo and
# keep it stable: changing it changes every subject_id.
EHR_SUBJECT_SALT=
